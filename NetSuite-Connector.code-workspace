{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"editor.formatOnPaste": true,
		"editor.formatOnSave": true,
		"editor.codeActionsOnSave": {
			"source.organizeImports": "explicit",
			"source.fixAll": "explicit",
			"source.removeUnusedImports": "explicit"
		},
		"pylint.args": [
			"--disable=W0108,C0103,C0114,C0115,C0116,C0301,R0902,R0913,R0917"
		],
		"mypy-type-checker.args": [
			"--ignore-missing-imports",
			"--follow-imports=silent",
			"--show-error-codes",
			"--ignore-assignments",
		],
		"python.testing.pytestArgs": [
			"."
		],
		"flake8.args": [
			"--max-line-length=88",
			"--extend-ignore=E501,W503,E203"
		],
		"python.testing.unittestEnabled": false,
		"python.testing.pytestEnabled": true,
		"testing.coverageBarThresholds": {
			"red": 0,
			"yellow": 60,
			"green": 90
		},
		"testing.showCoverageInExplorer": true,
		"testing.displayedCoveragePercent": "totalCoverage",
		"testing.automaticallyOpenTestResults": "openExplorerOnTestStart"
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "generate_requirements",
				"type": "shell",
				"command": "./poetry-requirements.sh",
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"presentation": {
					"reveal": "always",
					"panel": "new"
				},
				"problemMatcher": [],
				"options": {
					"env": {}
				}
			}
		]
	},
}