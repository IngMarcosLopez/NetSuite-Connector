modules = ["python-3.12", "python-base-3.11", "python-3.11"]
run = "PYTHONPATH=src python -m pytest tests/ -v"

[nix]
channel = "stable-24_05"
packages = ["cargo", "glibcLocales", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "unixODBC"]

[deployment]
run = ["sh", "-c", "PYTHONPATH=src python -m pytest tests/ -v"]

[workflows]
runButton = "Run Tests"

[[workflows.workflow]]
name = "Run Tests"
author = 44869599
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PYTHONPATH=src python -m pytest tests/ -v"
