modules = ["python-3.12", "python-base-3.11", "python-3.11"]
run = "python -m pip list --outdated"

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "unixODBC"]

[deployment]
run = ["sh", "-c", "python -m pip list --outdated"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MCP Demo"

[[workflows.workflow]]
name = "MCP Demo"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace && poetry run python examples/mcp_demo.py"
